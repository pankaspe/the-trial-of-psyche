	.Where_II_2     = "Un fiume largo, alla prima luce",
	.Where_II_3     = "La rupe nuda, in pieno giorno",
	.Where_II_4     = "Un tempio tra le montagne, al tramonto",
	.Where_III_1    = "Il cortile di Venere, dal giorno alla sera",
	.Where_III_2    = "I pascoli del Sole, isole sul fiume",
	.Where_III_3    = "La gola dello Stige, nel buio",
	.Where_III_4    = "La vetta dello Stige, dove l'acqua nera grida",
	.Where_III_5    = "La casa di Venere, di nuovo",
	.Where_IV_1     = "Una torre che scende fino al Tenaro",
	.Where_IV_2     = "La terra dei morti, e il regno appeso sotto",
	.Where_IV_3     = "Un solo pavimento per due mondi",
	.Where_IV_4     = "La soglia di Proserpina",
