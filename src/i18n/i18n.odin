EN := [Key]string {
	.Title          = "The Trial of Psyche",
	.Play           = "Enter the palace",
	.Levels         = "Levels",
	.Book           = "The Book",
	.Settings       = "Settings",
	.Quit           = "Quit",
	.Footer         = "Apuleius · Metamorphoses IV–VI",
	.Quote          = "“Do not seek to see my face.”\n— Apuleius, Metamorphoses V",
	.Lang_Name      = "English",

	.Act_1          = "Act I",
	.Act_2          = "Act II",
	.Act_3          = "Act III",
	.Act_4          = "Act IV",
	.Act_Epilogue   = "Epilogue",
	.Act_1_Title    = "The Palace of Voices",
	.Act_2_Title    = "Abandoned",
	.Act_3_Title    = "The Trials of Venus",
	.Act_4_Title    = "Proserpina's Box",
	.Act_Epilogue_Title = "The Awakening",
	.Act_1_Card     = "“On the crag of a high mountain, king, leave the girl, dressed for a wedding of death. Hope for no son-in-law of mortal birth.”\nSo Apollo answers. Psyche climbs the crag alone, and the wind takes her.",
	.Act_2_Card     = "The drop of oil has woken the god. Cupid flies away, and the palace melts into the air.\nPsyche is left alone on the earth, to search for him.",
	.Act_3_Card     = "Psyche knocks at the door of Venus. The goddess laughs and sets her impossible tasks.\nBut small creatures take pity on her.",
	.Act_4_Card     = "The last trial: go down to Proserpina and ask her for a little of her beauty, shut in a box.\nNo one comes back from Hades.",
	.Act_Epilogue_Card = "Psyche sleeps the sleep of the Styx, like one dead.\nFar away, a window opens.",
	.Card_Continue  = "Click to continue",
	.Card_Unbuilt   = "This act is still being built.",

	.Pro_Oracle     = "“On the crag of a high mountain, king, leave the girl, dressed for a wedding of death. Hope for no son-in-law of mortal birth.”",
	.Pro_Procession = "So Apollo answers. The king obeys: the whole city leads his daughter up the crag.",
	.Pro_Leave      = "Up there they leave her. They turn back, putting out the torches one by one.",
	.Pro_Alone      = "Psyche is left alone on the summit, weeping. Around the mountain, the air begins to stir.",
	.Pro_Start      = "Press any key to begin",
	.Fl_Wake        = "The drop of oil burns the god's shoulder. Cupid wakes and, without a word, flies away.",
	.Fl_Cling       = "Psyche clings to his leg and rises with him into the night, until her strength fails.",
	.Fl_Fall        = "She falls slowly, like a leaf, into a far forest. The palace has melted into the air.",
	.Fl_Alone       = "Cupid flies on and is lost among the stars. Psyche is left alone in the dark, with her lamp.",
	.Ve_Task        = "Venus laughs at her. Then she pours out a heap of seeds: wheat, barley, millet, poppy, chickpeas, lentils, beans, all mixed together.",
	.Ve_Leave       = "“Sort them, every seed in its place, before evening.” And she goes off to a wedding feast.",
	.Ve_Ants        = "Psyche does not touch a single seed. But a little country ant takes pity on the bride of Cupid, and calls all her people.",
	.Ve_Alone       = "They come running in waves, one file after another.",
	.Tw_Brink       = "From the edge of the tower Psyche looks down. One leap, and she will be among the shades.",
	.Tw_Voice       = "But all at once the tower speaks: «Why do you want to die, poor girl? Whoever goes down that way never comes back to the light.»",
	.Tw_Way         = "«Go to Taenarus. Hold two cakes of barley and honey in your hands, and two coins in your mouth: the ferryman wants his fare.»",
	.Tw_Alone       = "Psyche draws back from the edge, and begins to go down.",

	.Level_I_1      = "Zephyr's Crag",
	.Level_I_2      = "The Invisible Palace",
	.Level_I_3      = "The Sisters on the Crag",
	.Level_I_4      = "The Lamp and the Razor",
	.Level_II_1     = "Cupid's Flight",
	.Level_II_2     = "The River and Pan",
	.Level_II_3     = "The Sisters' Crag",
	.Level_II_4     = "The Temple of Ceres and Juno",
	.Level_III_1    = "The House of Venus",
	.Level_III_2    = "The Flock of the Sun",
	.Level_III_3    = "Jupiter's Eagle",
	.Level_III_4    = "The Water of the Styx",
	.Level_III_5    = "The Order of the Box",
	.Level_IV_1     = "The Speaking Tower",
	.Level_IV_2     = "The Underside of the World",
	.Level_IV_3     = "The Stone of Two Worlds",
	.Level_IV_4     = "Cerberus and Proserpina",
	.Level_IV_5     = "The Open Box",
	.Level_Epilogue = "The Awakening and the Wedding",

	.Level_Unbuilt  = "Still being built",
	.Where_I_1      = "A crag above the clouds, at sunset",
	.Where_I_2      = "The palace no hand has built, at dusk",
	.Where_I_3      = "The palace by night, its candles lit",
	.Where_I_4      = "The bridegroom's tower, in the deep dark",
	.Where_II_1     = "A forest of rock pillars, in the dead of night",
	.Where_II_2     = "A wide river, at first light",
	.Where_II_3     = "The bare crag, in broad day",
	.Where_II_4     = "A temple among the ranges, at sunset",
	.Where_III_1    = "Venus's court, from day to evening",
	.Where_III_2    = "The pastures of the Sun, islands in the river",
	.Where_III_3    = "The gorge of the Styx, in the dark",
	.Where_III_4    = "The summit of the Styx, where the black water cries",
	.Where_III_5    = "The house of Venus, once more",
	.Where_IV_1     = "A tower going down to Taenarus",
	.Where_IV_2     = "The land of the dead, and the kingdom hanging below",
	.Where_IV_3     = "One floor for two worlds",
	.Where_IV_4     = "Proserpina's threshold",
	.Where_IV_5     = "The way back",
	.Where_Epilogue = "Heaven, at the wedding",
	.Device_Seals   = "Seals",
	.Device_Veiled  = "Veiled stones",
	.Device_Handles = "Handles",
	.Device_Caves   = "Caves",
	.Device_Braziers = "Braziers",
	.Device_Sundials = "Sundials",
	.Device_Rams    = "The Sun's rams",
	.Device_Eagle   = "The eagle",
	.Device_Pomegranates = "Pomegranates",
	.Device_Boat    = "The boat",
	.Device_Guard   = "Candelabra",
	.Levels_Act     = "act",
	.Levels_Level   = "level",
	.Levels_Play    = "play",
	.Levels_Done    = "Completed",
	.Levels_Open    = "Not yet played",
	.Level_Locked   = "Finish the levels before it first",
	.Fragments_Label = "Fragments",

	.Fragment_01    = "In a certain city there were a king and a queen, with three daughters. The two elder were beautiful; the youngest so beautiful that words fell short.",
	.Fragment_02    = "People came from everywhere to see her, and worshipped her as a new Venus. The goddess's temples stood empty, her altars cold.",
	.Fragment_03    = "The elder sister complains: she got a husband older than her father, balder than a gourd, who keeps the house shut with bars and chains.",
	.Fragment_03b   = "“And I,” says the other, “have a husband bent double by aching joints. I rub his crooked fingers with stinking poultices: not a wife, a nurse.”",
	.Fragment_04    = "Her father, fearing the anger of the gods, consults the ancient oracle of Apollo at Miletus. The god answers in verse: the bridegroom is a winged evil that makes even Jupiter tremble.",
	.Fragment_05b   = "In the lamplight there is no beast: there is Love, the fairest of the gods. Golden hair fragrant with ambrosia, dewy wings shining on his shoulders. Even the flame, seeing him, burns brighter.",
	.Fragment_05    = "Looking at the god's weapons, Psyche pricks herself on one of his arrows. So, without knowing it, she falls in love with Love.",
	.Fragment_06    = "The wedding torches burn with black smoke, the flute plays a lament. The whole city follows the bride as if to a funeral.",
	.Fragment_07    = "A white gull dives to the bottom of the sea and tells Venus everything: her son is wounded, and he loves a mortal.",
	.Fragment_07b   = "Psyche tells her sister: “By the lamplight I saw my husband: it was Love himself. Woken by the oil, he drove me out: ‘Go. I will marry your sister.’ And he bade Zephyr carry me away.”",
	.Fragment_08    = "Venus scolds her son with harsh words and locks him in a room of her house, so that he will not see the girl again.",
	.Fragment_08b   = "Psyche kneels before the altar of Ceres: “By your hand that gives the harvest, by the glad feasts of reaping, by the secrets kept in the baskets, let me hide here among the ears of wheat, a few days only, until the goddess's anger is soothed.”",
	.Fragment_08c   = "Ceres and Juno try to calm her: he is young, he is in love, why punish him? But they speak so for fear of his arrows.",
	.Fragment_08d   = "Psyche prays before the altar of Juno: “Sister and wife of great Jupiter, whether you dwell in your ancient shrines at Samos, or in the blessed seats of lofty Carthage, or guard the walls of Argos by the Inachus: the East honours you as Zygia, the West calls you Lucina. Be Juno the Saviour to me in my last distress, and free me from this fear. I know you help the women who are waiting for a child.”",
	.Fragment_10    = "Mercury cries the proclamation through every street: whoever brings back the runaway will have seven kisses from Venus.",
	.Fragment_11    = "Cupid is shut in a room at the back of the house, far from everyone. The wound of the lamp heals slowly.",
	.Fragment_11b   = "A green reed, nurse of sweet music, stirred by a breath of wind: “Psyche, do not stain my holy waters with your death. And do not go among the sheep while the sun burns: its heat makes them wild, their horns sharp, their bites poisonous. Wait for evening, when they grow calm, and gather the golden wool left on the briars.”",
	.Fragment_11c   = "At dawn Venus points her to a grove along the river, where sheep shining with gold are grazing. Psyche goes willingly, but not to obey: she means to throw herself from a rock into the river and find rest at last.",
	.Fragment_12    = "Venus goes off to a wedding feast, perfumed and crowned with roses. She leaves Psyche alone with the impossible task.",
	.Fragment_12b   = "Suddenly the royal bird of Jupiter appears, the raptor eagle, its wings spread wide. It remembers the old service: Cupid guided it when it carried the Phrygian boy up to heaven to be Jupiter's cupbearer. Now it comes to the aid of Cupid's bride.",
	.Fragment_13    = "Black water falls from a towering crag, between smooth rocks. Sleepless dragons guard it, and the waters themselves cry out: “Go away!”",
	.Fragment_13b   = "At the sight Psyche stands like stone: her body is there, her mind is elsewhere. The danger is so great that she lacks even the last comfort, tears.",
	.Fragment_13c   = "“Do you hope, simple girl, to steal one drop from this most holy and cruel spring? The gods, Jupiter himself, fear the waters of the Styx: as you swear by the gods, so they swear by the majesty of the Styx.”",
	.Fragment_14    = "“Go to Proserpina,” says Venus, “and ask her for a little of her beauty, enough for a single day.”",
	.Fragment_14b   = "Venus glares at her: “By now you seem to me a witch, a great and deep enchantress, to have obeyed my orders so well. But there is still one thing you must do for me.”",
	.Fragment_14c   = "“Take this box. And come back soon: I must anoint myself with her beauty before I go to the theatre of the gods.”",
	.Fragment_15    = "«But above all, I tell you: the box you will carry, do not open it, do not look inside. Do not be curious about the treasure of divine beauty.»",
	.Fragment_15b   = "«Further on, old women weaving will beg you to lend a hand at the loom. Do not touch the cloth: these are Venus's snares, to make you drop a cake.»",
	.Fragment_16    = "Psyche passes on in silence: by the lame driver, by the dead man reaching out of the river, by the old women calling her to the loom. She touches nothing, answers no one: she holds her cakes tight.",
	.Fragment_17    = "Charon does nothing for free. Even among the dead greed lives on: whoever dies must carry the coin in his mouth.",
	.Fragment_17b   = "«On the way you will meet a lame ass loaded with wood, and a driver as lame as his beast, who will ask you to pick up a few sticks fallen from the load. Pass by without a word.»",
	.Fragment_17c   = "«As you cross the river, a dead old man floating by will lift his wasted hands to you and beg you to pull him into the boat. Do not give in to a pity that is not allowed you.»",
	.Fragment_18    = "Proserpina offers her a soft seat and a rich feast. Psyche sits on the ground and asks only for coarse bread.",
	.Fragment_19    = "Cupid, healed, can bear the separation no longer. He escapes through the high window of his prison and flies to her.",
	.Fragment_20    = "So the wedding is made, and a daughter is born whom they call Pleasure.\nThis was the tale an old woman told a captive girl, in the robbers' cave.",
	.Fragment_Found = "Fragment of the Tale",
	.Fragment_Continue = "Click or Enter to continue",
	.Mech_New       = "New",
	.Mech_Veiled_Title = "Veiled stones",
	.Mech_Veiled    = "In the dark, veiled stones and planks are not there. The lamp shows them in gold\nand, close by, makes them real for good.",
	.Mech_Handle_Title = "Handles",
	.Mech_Handle    = "A handle moves the part marked by the bronze inlay.\nStanding on the handle, press 2 (or click Psyche): the spindle turns it, and the part turns a quarter.",
	.Mech_Time_Title = "Day and evening",
	.Mech_Time      = "On the sundial, press 2 (or click Psyche): the spindle turns the time.\nBy day the sun shows the truth and its stairs stand, but the lamp stays dark. At evening the stairs of the sun crumble, the illusions return and the lamp can be lit.",
	.Mech_Time_Pad  = "On the sundial, press {RT}: the spindle turns the time.\nBy day the sun shows the truth and its stairs stand, but the lamp stays dark. At evening the stairs of the sun crumble, the illusions return and the lamp can be lit.",
	.Mech_Eagle_Title = "Jupiter's eagle",
	.Mech_Eagle     = "The eagle waits on its bronze perch.\nStanding on the perch, press Space: the eagle carries you where the golden light shines. One way only: to come back you need another eagle.",
	.Mech_Eagle_Pad = "The eagle waits on its bronze perch.\nStanding on the perch, press {S}: the eagle carries you where the golden light shines. One way only: to come back you need another eagle.",
	.Mech_Flip_Title = "Proserpina's pomegranates",
	.Mech_Flip      = "Under the world hangs another, upside down. On the stones of the axle grow Proserpina's pomegranates.\nStanding on a pomegranate, press 2 (or click Psyche): the spindle turns the world over, and you walk on the underside of the stones.",
	.Mech_Flip_Pad  = "Under the world hangs another, upside down. On the stones of the axle grow Proserpina's pomegranates.\nStanding on a pomegranate, press {RT}: the spindle turns the world over, and you walk on the underside of the stones.",

