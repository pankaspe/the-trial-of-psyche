	.Controls       = "Click: walk  ·  Q / E: turn the palace  ·  1 / right click: lamp  ·  2: spindle  ·  Space: action of the place  ·  Tab: where is Psyche  ·  R: brazier (hold: start again)  ·  Esc: pause",
	.Controls_Dark  = "Click: walk  ·  Q / E: turn the palace  ·  Space: action of the place  ·  Tab: where is Psyche  ·  R: brazier (hold: start again)  ·  Esc: pause",

	.Intro_I_2      = "Psyche wakes on a meadow. Before her stands a palace not made by human hands, and bodiless voices ready to serve her.",
	.Intro_I_3      = "Every night the bridegroom comes back, and warns her: her sisters will try to make her look at his face. “If you see it, you will never see it again.”",
	.Intro_I_4      = "Night. The bridegroom sleeps at the top of the tower. Psyche has the lamp and the razor with her, as her sisters told her.",
	.Intro_II_1     = "Psyche rises among the rocks of the forest. To find him again she must cross the night.",
	.Intro_II_2     = "In despair, Psyche throws herself into the river. But the river fears the god who burns even the waters, and with a gentle wave it sets her on the bank.",
	.Intro_II_3     = "Psyche goes to her eldest sister and tells her: “My husband wants you now.” The sister runs to the crag, telling no one.",
	.Intro_II_4     = "Psyche wanders day and night in search of her husband. At dusk she finds a temple of Ceres and Juno: wheat and sickles in disorder, gifts hung on the columns.",
	.Intro_III_1    = "It is still day in the house of Venus. In the court, a sundial tells the hours.",
	.Intro_III_2    = "Along the river grazes the golden flock of the Sun. A reed whispers: wait for evening.",
	.Intro_III_3    = "Venus puts a crystal urn in her hands: “Fill it with the black water that springs from the summit.”",
	.Intro_III_4    = "At the summit the black water cries out. The eagles carry you up, but where they set you down the hour stays as it was: choose it before you fly.",
	.Intro_III_5    = "Back in the house of Venus. To leave it she will need everything she has learned: the lamp, the spindle, the cave, the eagle.",
	.Intro_IV_1     = "The tower has told you the way. Go down: at the bottom, on the dark water, the ferryman waits.",
	.Intro_IV_2     = "Beyond the river, Proserpina's kingdom hangs under the land of the dead, like a reflection in water.",
	.Intro_IV_3     = "Here the land of the dead and Proserpina's kingdom walk on the same stone: one above, the other below.",
	.V_Doubt        = "He sleeps. Your sisters' words come back to you: what if he is a monster? The lamp is in your hand.",

	.Tutorial_Label = "How to play",
	.Hint_Move      = "Click a tile to move Psyche",
	.Hint_Lamp      = "An unlit candelabrum waits for your flame: hold 1 (or the right button) and the lamp burns until you let go; the candelabrum will catch. The light shows what is real: here the portico hides a stair",
	.Hint_Lamp_Toggle = "An unlit candelabrum waits for your flame: press 1 (or right click) to light the lamp and it will catch. The light shows what is real: here the portico hides a stair",
	.Hint_Oil       = "The lamp burns oil while it is lit (the notches in its slot, on the left): let go of 1 and it goes out",
	.Hint_Oil_Toggle = "The lamp burns oil while it is lit (the notches in its slot, on the left): press 1 again to put it out",
	.Hint_Illusion  = "In the dark, what seems joined is joined: walk where the stones seem to touch",
	.Hint_Sigil     = "Another unlit candelabrum, on the seal: light the lamp here and the light will raise the bridge",
	.Hint_Fragment  = "That light up there is a fragment of the tale. You don't need it to go on, but each one brings the story back together in the Book: the count is at the top right",
	.Hint_Turn      = "The mountain never shows itself whole from one side. Press Q or E to walk around it: from elsewhere, distant rocks touch, and fragments of the tale come to light.",
	.Badge_Pause    = "Pause and controls",
	.Hint_Seam      = "In the light, there is no passage",
	.Hint_No_Oil    = "The oil is gone. R takes you back to the last brazier; hold R to start the level again",
	.Hint_No_Oil_No_Rest = "The oil is gone. Hold R to start the level again",
	.Hint_No_Oil_Twice = "The oil is gone. R takes you back to the last brazier; press R twice to start the level again",
	.Hint_No_Oil_No_Rest_Twice = "The oil is gone. Press R twice to start the level again",
	.Hint_No_Oil_Pad = "The oil is gone. {E} takes you back to the last brazier; hold {E} to start the level again",
	.Hint_No_Oil_No_Rest_Pad = "The oil is gone. Hold {E} to start the level again",
	.Hint_No_Oil_Twice_Pad = "The oil is gone. {E} takes you back to the last brazier; press {E} twice to start the level again",
	.Hint_No_Oil_No_Rest_Twice_Pad = "The oil is gone. Press {E} twice to start the level again",
	.Hint_Hidden_Stairs = "In the dark, stairs you cannot see lead nowhere",
	.Hint_Veiled    = "The lamp shows in gold what the dark hides: come near with the light, and it becomes real for good",
	.Hint_Handle    = "You stand on a handle: press 2 (or click Psyche) to turn the part it moves",
	.Hint_Sundial   = "You stand on the sundial: press 2 (or click Psyche) and the sun will set",
	.Hint_Pomegranate = "You stand on a pomegranate: press 2 (or click Psyche) and the world will turn over",
	.Hint_Eagle     = "You stand on the perch: press Space and the eagle will carry you where the golden light shines",
	.Hint_Eagle_No_Floor = "The eagle does not stir: where it would set you down there is no ground yet",
	.Hint_Boat      = "Charon is waiting: press Space to board the boat",
	.Hint_Guard     = "It is dark here: light the lamp beside the candelabrum, and its light will show you the way",
	.Hint_Lamp_Day  = "The sun already shows the truth: the flame waits for the evening",
	.Hint_Rest      = "A lit brazier: if you lose your way, R brings you back here (held down, it restarts the level)",
	.Card_Continue_Pad = "Press {S} to continue",
	.Pro_Start_Pad  = "Press any button to begin",
	.Fragment_Continue_Pad = "Press {S} to continue",
	.Mech_Handle_Pad = "A handle moves the part marked by the bronze inlay.\nStanding on the handle, press {RT}: the spindle turns it, and the part turns a quarter.",
	.Hint_No_Rest_Pad = "No brazier lit: hold {E} to start the level again",
	.Hint_Dead_End_Pad = "A dead end: there is no way on from here. {E} takes you back to the last brazier; hold {E} to start the level again",
	.Hint_Dead_End_No_Rest_Pad = "A dead end: there is no way on from here. Hold {E} to start the level again",
